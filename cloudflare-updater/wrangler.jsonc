{
  // Update API and APK hosting for the Dikho CRM Android app.
  // Deploy: npx wrangler deploy -c cloudflare-updater/wrangler.jsonc
  //
  // Deliberately separate from wrangler.api.jsonc: no D1, R2 or secret binding
  // exists here, so nothing on this public host can reach business data.
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "dikho-updates",
  "compatibility_date": "2026-08-20",
  "main": "src/index.js",
  "workers_dev": true,
  "preview_urls": false,
  "observability": { "enabled": true },
  "assets": {
    "directory": "./public",
    // Only these paths run the Worker. /releases/* is served as a static
    // asset, which costs no Worker invocation and no CPU.
    "run_worker_first": ["/api/*", "/download"]
  }
}
