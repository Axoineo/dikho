    "react-dom": "^19.2.8",
    "react-pdf": "^10.5.0",
    "react-router-dom": "^7.18.3",
    "react-virtualized-auto-sizer": "^2.0.3",
    "react-window": "^2.3.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.56.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
