# Copy this file to .env.local and fill in the values.
#   cp .env.example .env.local
#
# Only VITE_-prefixed variables are exposed to the browser bundle.
# Server-side secrets (service-role key, Brevo key) are NOT configured here —
# see the "Edge Function secrets" section of the README.

# Supabase project URL, e.g. https://your-project-ref.supabase.co
VITE_SUPABASE_URL=

# Supabase publishable ("anon") key.
# This is safe to ship in the browser — table access is enforced by Row Level
# Security, not by keeping this value secret. Never put the service-role key here.
VITE_SUPABASE_PUBLISHABLE_KEY=
