{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "dikho-so-po",
	"compatibility_date": "2026-08-20",
	"observability": {
		"enabled": true
	},
	// Standalone SPA Worker. Production (manage.dikho.in) does NOT use it: the
	// SPA is served by Cloudflare Pages, built from every push to main, so
	// `npm run deploy` publishes this Worker without changing the live site.
	// The API is a separate Worker, see wrangler.api.jsonc. No D1 or WhatsApp
	// bindings belong here.
	"main": "src/worker.js",
	"assets": {
		"directory": "dist",
		"not_found_handling": "single-page-application"
	},
	"d1_databases": [
		{
			"binding": "dikho_whatsapp",
			"database_name": "dikho-whatsapp",
			"database_id": "58bc3063-789d-412e-83e2-f282806fc606"
		}
	]
}