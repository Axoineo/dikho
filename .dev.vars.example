# Copy to .dev.vars for local `wrangler dev` (gitignored, never commit real values).
# In production these are set with `wrangler secret put <NAME>`.

# Meta App Dashboard > WhatsApp > Configuration > Webhook > Verify token.
# Must match exactly what you paste into the Meta dashboard.
WHATSAPP_VERIFY_TOKEN=DikhoWebhook_DGMx2026

# Meta App Dashboard > WhatsApp > API Setup (or a permanent System User token).
WHATSAPP_ACCESS_TOKEN=

WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WABA_ID=
WHATSAPP_APP_ID=
WHATSAPP_APP_SECRET=

# Name/language of the single approved static template, used as a fallback
# when the Meta Graph API cannot be reached.
WHATSAPP_STATIC_TEMPLATE_NAME=september_offer
WHATSAPP_STATIC_TEMPLATE_LANG=en

# Approved AUTHENTICATION-category template used to deliver login OTP codes.
# Must match the template name/language configured on Meta (see docs/whatsapp-auth.md).
WHATSAPP_AUTH_TEMPLATE_NAME=dikho_auth
WHATSAPP_AUTH_TEMPLATE_LANG=en

# Secret shown when you enable Supabase Auth > Hooks > "Send SMS hook" (HTTPS).
# Shaped like `v1,whsec_...`. The Worker verifies every hook call's Standard
# Webhooks signature against this, so only Supabase can trigger an OTP send.
SUPABASE_SEND_SMS_HOOK_SECRET=

# Used by the Worker to validate the dashboard's Supabase session tokens.
# The anon/publishable key is safe here — it is already public in the browser.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Comma-separated list of origins allowed to call authenticated /api routes.
ALLOWED_ORIGINS=https://manage.dikho.in,http://localhost:5173
