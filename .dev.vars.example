# Copy to .dev.vars for local `wrangler dev` (gitignored, never commit real values).
# In production these are set with `wrangler secret put <NAME>`.

# Meta App Dashboard > WhatsApp > Configuration > Webhook > Verify token.
# Must match exactly what you paste into the Meta dashboard.
# Generate a random one, e.g. `openssl rand -hex 16`, and set it as a Worker
# secret with `wrangler secret put WHATSAPP_VERIFY_TOKEN`. Never commit the real value.
WHATSAPP_VERIFY_TOKEN=<your-webhook-verify-token>

# Meta App Dashboard > WhatsApp > API Setup (or a permanent System User token).
WHATSAPP_ACCESS_TOKEN=

WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WABA_ID=
WHATSAPP_APP_ID=
WHATSAPP_APP_SECRET=

# Name/language of the single approved static template, used as a fallback
# when the Meta Graph API cannot be reached.
WHATSAPP_STATIC_TEMPLATE_NAME=september_offer
WHATSAPP_STATIC_TEMPLATE_LANG=en

# Approved AUTHENTICATION-category template used to deliver login OTP codes.
# Must match the template name/language configured on Meta (see docs/whatsapp-auth.md).
WHATSAPP_AUTH_TEMPLATE_NAME=dikho_auth
WHATSAPP_AUTH_TEMPLATE_LANG=en

# Secret shown when you enable Supabase Auth > Hooks > "Send SMS hook" (HTTPS).
# Shaped like `v1,whsec_...`. The Worker verifies every hook call's Standard
# Webhooks signature against this, so only Supabase can trigger an OTP send.
SUPABASE_SEND_SMS_HOOK_SECRET=

# Used by the Worker to validate the dashboard's Supabase session tokens.
# The anon/publishable key is safe here — it is already public in the browser.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Comma-separated list of origins allowed to call /api routes. This must also
# list whatever origin serves the PUBLIC forms (/vendor/register and
# /corporategifting), or their POST to /api/public/* is blocked by CORS.
ALLOWED_ORIGINS=https://manage.dikho.in,http://localhost:5173

# ─── Cloudflare Turnstile ───────────────────────────────────────────────────
# Gates the two unauthenticated public form writes (/api/public/vendor and
# /api/public/cg-lead). See src/api/services/turnstile.js.
#
# Secret for widget 0x4AAAAAAEnxgBvSPuBu7S85 ("managed" mode). Read it with:
#   npx wrangler turnstile widget get 0x4AAAAAAEnxgBvSPuBu7S85 --json
# and set it in production WITHOUT putting it on the command line:
#   npx wrangler secret put TURNSTILE_SECRET --name dikho-api
# The verification fails CLOSED if this is missing, so a dropped secret breaks
# the forms rather than quietly leaving them open.
TURNSTILE_SECRET=

# Comma-separated hostnames siteverify is allowed to report as the page that
# solved the challenge. PRODUCTION MUST NOT include localhost/127.0.0.1 —
# otherwise a token solved on an attacker's local page would be accepted.
#   local:      localhost,127.0.0.1
#   production: manage.dikho.in,dikho.pages.dev
# These must also be listed as the widget's allowed domains in the Cloudflare
# dashboard (currently: 127.0.0.1, dikho.pages.dev, localhost, manage.dikho.in).
TURNSTILE_HOSTNAMES=localhost,127.0.0.1

# ─── Supabase service role ──────────────────────────────────────────────────
# Lets the Worker call public_register_vendor / public_submit_cg_lead after the
# Turnstile check passes. Migration 20260927000000_turnstile_lockdown.sql revokes
# anon's EXECUTE on those functions, so this is the only way in.
#
# This key bypasses Row Level Security completely. It must NEVER be given a
# VITE_ prefix or put in .env.local — that would ship it to the browser. Set it
# in production with:
#   npx wrangler secret put SUPABASE_SERVICE_ROLE_KEY --name dikho-api
SUPABASE_SERVICE_ROLE_KEY=
