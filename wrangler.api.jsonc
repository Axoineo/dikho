{
  // Standalone API Worker -> https://dikho-api.fineeurox.workers.dev
  // Deploy with:  npm run deploy:api
  // Dev with:     npm run dev:api
  //
  // The dashboard SPA is a SEPARATE Worker (wrangler.jsonc) on
  // manage.dikho.in. Keep the two configs distinct: this one must not
  // serve assets, and that one must not carry API bindings.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dikho-api",
  "compatibility_date": "2026-08-20",
  "main": "src/api/worker.js",
  "workers_dev": true,
  // Drains the delivery-receipt backlog (src/api/services/whatsapp/reconcile.js).
  // Receipts that beat their own wamid into the database are parked as
  // 'unmatched' by the webhook; this sweep applies them minutes later.
  "triggers": {
    "crons": ["*/10 * * * *"]
  },
  "observability": {
    "enabled": true
  },
  // WhatsApp campaign send sizing (src/api/routes/campaigns/index.js). Sized
  // for the Workers FREE plan's 50-external-subrequest-per-invocation cap —
  // CAMPAIGN_CONCURRENCY must stay ≤6 (Workers cap simultaneous in-flight
  // connections at 6 regardless of plan) and CAMPAIGN_BATCH_LIMIT must stay
  // comfortably under whatever the account's subrequest limit is.
  // If this account moves to the Workers PAID plan (10,000+ subrequests per
  // invocation by default, configurable up to 10M), raise these — e.g.
  // CAMPAIGN_BATCH_LIMIT: "900", CAMPAIGN_CONCURRENCY: "6" — and redeploy
  // with `npm run deploy:api`. No code change needed.
  // Safe to commit as plain vars (unlike the Meta IDs elsewhere, these carry
  // no secret value).
  "vars": {
    "CAMPAIGN_BATCH_LIMIT": "40",
    "CAMPAIGN_CONCURRENCY": "5",
    // Hostnames Turnstile's siteverify may report as the page that solved the
    // challenge, for the public form routes (src/api/services/turnstile.js).
    // Non-secret (these are public domains), and kept HERE rather than as a
    // remote-only var so a deploy can never silently drop it — the same trap
    // that wiped the Meta IDs. `.dev.vars` overrides this for local dev, which
    // is why localhost/127.0.0.1 are deliberately absent: a token solved on an
    // attacker's own localhost page must not verify against production.
    "TURNSTILE_HOSTNAMES": "manage.dikho.in,dikho.pages.dev",
    // API Setu (apisetu.gov.in) client id for the GSTIN autofill lookup —
    // src/api/services/apisetu/client.js. Printed openly in the API Setu
    // console sidebar, so it carries no secret value and belongs here rather
    // than as a remote-only var a deploy could wipe. The paired API key IS
    // secret and is set with `wrangler secret put APISETU_API_KEY`.
    "APISETU_CLIENT_ID": "in.dikho",
    // The origin declared to API Setu as the caller, sent as a `Referer` header
    // by src/api/services/apisetu/client.js. Must match whatever is entered as
    // the key's "Whitelist Domain/Url" in the API Setu console — that check is
    // built for browser callers and reads Origin/Referer, which a Worker's
    // server-to-server fetch does not otherwise send.
    //
    // Accurate rather than cosmetic: this genuinely is the host making the
    // call. Leave it empty to send no Referer at all.
    "APISETU_REFERER": "https://dikho-api.fineeurox.workers.dev"
  },
  // Per-IP throttle for GET /api/gstn/:gstin (src/api/routes/gstn/index.js).
  // Deliberately NOT backed by D1: that database's free-plan row-write budget
  // is already load-bearing for WhatsApp, and a rate limiter must not be able
  // to exhaust it. This binding keeps no storage at all.
  // `namespace_id` is any stable integer-as-string unique within this Worker;
  // `period` accepts only 10 or 60.
  //
  // MEASURED BEHAVIOUR, 2026-09-29 — do NOT read "12 per 60s per IP" as a hard
  // cap. Cloudflare counts per DATA CENTRE and documents the binding as
  // "permissive, eventually consistent, and intentionally designed to not be
  // used as an accurate accounting system". Tested against this Worker:
  //
  //   limit 12 → 82 requests, one stable IP, 56 of them landing in a single
  //              colo (SIN): ZERO denials.
  //   limit  1 →  6 requests: denied the 4th only, passed 1,2,3,5,6.
  //
  // So it does fire, just far later and less often than the number suggests,
  // and one client spread over several colos gets a multiple of the limit. Treat
  // it as a brake on runaway loops and accidental hammering — which it does do —
  // and NOT as the thing protecting the API Setu quota. A hard cap needs a
  // strongly-consistent counter (Durable Object) or a global daily budget.
  "ratelimits": [
    {
      "name": "GSTIN_RATE_LIMITER",
      "namespace_id": "2001",
      "simple": { "limit": 12, "period": 60 }
    }
  ],
  // The API code reads this as `c.env.DB`, so the binding name must stay "DB".
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "dikho-whatsapp",
      "database_id": "58bc3063-789d-412e-83e2-f282806fc606",
      "migrations_dir": "migrations"
    }
  ],
  // Re-hosted WhatsApp media (inbound downloads + outbound copies). Read as
  // `c.env.MEDIA`. Create the bucket once before first deploy:
  //   npx wrangler r2 bucket create dikho-whatsapp-media
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "dikho-whatsapp-media"
    }
  ]
}
